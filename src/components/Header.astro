---
import { buttonVariants } from "@/components/ui/button";
---

<header
  class="bg-background/95 supports-[backdrop-filter]:bg-background/60 sticky top-0 z-50 w-full border-b backdrop-blur"
>
  <div
    class="container flex h-14 items-center space-x-4 sm:justify-between sm:space-x-0"
  >
    <div class="flex gap-6 md:gap-10">
      <a href="/" class="flex items-center">
        <img src="/assets/logo_no_bg_nw_82885400.png" alt="Ecclesia Logo" class="h-6 w-auto" />
      </a>
    </div>
    <div class="flex flex-1 items-center justify-end space-x-4">
      <nav class="hidden md:flex items-center space-x-4">
        <a
          href="/"
          class="text-foreground/80 hover:text-foreground text-xs font-medium transition-colors px-2 py-1"
        >
          Home
        </a>
        <a
          href="/#about"
          class="text-foreground/80 hover:text-foreground text-xs font-medium transition-colors px-2 py-1"
        >
          Who We Are
        </a>
        <a
          href="/what-we-believe"
          class="text-foreground/80 hover:text-foreground text-xs font-medium transition-colors px-2 py-1"
        >
          What We Believe
        </a>
        <a
          href="/events"
          class="text-foreground/80 hover:text-foreground text-xs font-medium transition-colors px-2 py-1"
        >
          Events
        </a>
        <a
          href="/#contact"
          class="text-foreground/80 hover:text-foreground text-xs font-medium transition-colors px-2 py-1"
        >
          Contact Us
        </a>
        <a
          href="https://www.paypal.com/donate/?hosted_button_id=RM8SJ6QPAXN8Q"
          target="_blank"
          rel="noreferrer"
          class={buttonVariants({ variant: 'default', size: 'xs', className: 'px-3 py-1 text-xs' })}
        >
          Donate
        </a>
      </nav>
      <button id="mobile-menu-toggle" class="md:hidden inline-flex items-center justify-center rounded-md p-1 text-foreground hover:bg-accent/10 hover:text-accent transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <span class="sr-only">Toggle menu</span>
      </button>
    </div>
  </div>
  
  <div id="mobile-menu" class="md:hidden hidden">
    <div class="space-y-1 px-4 py-4 border-t">
      <a
        href="/"
        class="block py-2 px-3 text-base font-medium rounded-md hover:bg-accent/10 hover:text-accent transition-colors"
      >
        Home
      </a>
      <a
        href="/#about"
        class="block py-2 px-3 text-base font-medium rounded-md hover:bg-accent/10 hover:text-accent transition-colors"
      >
        Who We Are
      </a>
      <a
        href="/what-we-believe"
        class="block py-2 px-3 text-base font-medium rounded-md hover:bg-accent/10 hover:text-accent transition-colors"
      >
        What We Believe
      </a>
      <a
        href="/events"
        class="block py-2 px-3 text-base font-medium rounded-md hover:bg-accent/10 hover:text-accent transition-colors"
      >
        Events
      </a>
      <a
        href="/#contact"
        class="block py-2 px-3 text-base font-medium rounded-md hover:bg-accent/10 hover:text-accent transition-colors"
      >
        Contact Us
      </a>
      <a
        href="https://www.paypal.com/donate/?hosted_button_id=RM8SJ6QPAXN8Q"
        target="_blank"
        rel="noreferrer"
        class="block py-2 px-3 text-base font-medium rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
      >
        Donate
      </a>
    </div>
  </div>
</header>

<script>
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuToggle && mobileMenu) {
    mobileMenuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>