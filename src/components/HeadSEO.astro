---
import "@/styles/global.css";
import "@/styles/fonts.css";
import seoImage from "../assets/logo-wood-1-1_nw_845a8ea5.jpg";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  ogImage?: URL | undefined;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

if (Astro.props.ogImage === undefined) {
  Astro.props.ogImage = new URL(seoImage.src, Astro.site);
}

const { 
  title = "Ecclesia Tulsa | A Community of Home Churches", 
  description = "Ecclesia Tulsa is a community of believers gathering in homes throughout Tulsa to live out Acts 2:42-47 through authentic fellowship, meaningful discipleship, and transformative service.", 
  ogImage 
} = Astro.props;
---

<meta charset="utf-8" />
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content="new.website - https://new.website" />
<link rel="canonical" href={canonicalURL.toString()} />
<link
  rel="shortcut icon"
  type="image/svg+xml"
  href={new URL('favicon.svg', Astro.site).toString()}
/>
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(seoImage.src, Astro.site).toString()} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL.toString()} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(seoImage.src, Astro.site).toString()} />

<!-- DO NOT REMOVE - Plausible Analytics must always be enabled -->
<script is:inline>
  // Plausible Analytics - Dynamic Domain Detection
  // This script automatically detects the current domain and loads Plausible analytics
  if (typeof window !== 'undefined') {
    (function() {
      const hostname = window.location.hostname;

      // Only track production domains (exclude localhost, IP addresses, etc.)
      if (hostname !== 'localhost' && !hostname.match(/^\d+\.\d+\.\d+$/)) {
        // Defer script loading to avoid DOM manipulation conflicts
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function() {
            const script = document.createElement('script');
            script.defer = true;
            script.setAttribute('data-domain', hostname);
            script.src = 'https://plausible.io/js/script.js';
            document.head.appendChild(script);
          });
        } else {
          const script = document.createElement('script');
          script.defer = true;
          script.setAttribute('data-domain', hostname);
          script.src = 'https://plausible.io/js/script.js';
          document.head.appendChild(script);
        }
      }
    })();
  }
</script>
