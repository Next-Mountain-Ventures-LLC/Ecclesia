---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSection from '@/components/HeroSection';
import AboutSection from '@/components/AboutSection';
import EcosystemSection from '@/components/EcosystemSection';
import GatheringsSection from '@/components/GatheringsSection';
import EventsSection from '@/components/EventsSection';
import ContactSection from '@/components/ContactSection';
import { Image } from 'astro:assets';
import logoWood from '../assets/logo_wood_bg_nw_1efb2b0b.jpg';
---

<BaseLayout
  title="Ecclesia Tulsa | A Community of Home Churches"
  description="Ecclesia Tulsa is a community of believers gathering in homes throughout Tulsa to live out Acts 2:42-47 through authentic fellowship, meaningful discipleship, and transformative service."
>
  <HeroSection client:load />
  
  <AboutSection client:load />
  
  <div id="gatherings">
    <GatheringsSection client:load />
  </div>
  
  <EcosystemSection client:load />
  
  <EventsSection client:load />
  
  <ContactSection client:load />
</BaseLayout>