---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSection from '@/components/HeroSection';
import AboutSection from '@/components/AboutSection';
import EcosystemSection from '@/components/EcosystemSection';
import GatheringsSection from '@/components/GatheringsSection';
import EventsSection from '@/components/EventsSection';
import ContactSection from '@/components/ContactSection';
import '../styles/gathering-animation.css';
---

<BaseLayout
  title="Ecclesia Tulsa | A Community of Home Churches"
  description="Ecclesia Tulsa is a community of believers gathering in homes throughout Tulsa to live out Acts 2:42-47 through authentic fellowship, meaningful discipleship, and transformative service."
>
  <HeroSection client:load />
  
  <AboutSection client:load />
  
  <!-- Scripture reference moved above Gatherings section as requested -->
  <div class="w-full py-12 bg-primary-50">
    <div class="container text-center">
      <div class="inline-block rounded-full px-6 py-1.5 bg-primary-100 text-primary-700 font-medium text-sm mb-4">
        Acts 2:42-47
      </div>
      <blockquote class="max-w-3xl mx-auto text-lg md:text-xl italic text-primary-800 font-display">
        "They <span class="font-semibold text-accent-600">devoted themselves to the apostles' teaching</span> and to fellowship, to the breaking of bread and to prayer. Everyone was filled with awe at the many wonders and signs performed by the apostles. All the believers were together and had everything in common."
      </blockquote>
    </div>
  </div>
  
  <div id="gatherings">
    <GatheringsSection client:load />
  </div>
  
  <EcosystemSection client:load />

  <div class="py-12"></div>

  <!-- EventsSection hidden for now - uncomment to restore -->
  <!-- <EventsSection client:load /> -->
  
  <ContactSection client:load />

  <!-- Hidden form for Netlify form detection -->
  <form name="ecclesia-contact" netlify netlify-honeypot="bot-field" hidden>
    <input type="hidden" name="form-name" value="ecclesia-contact" />
    <input type="text" name="bot-field" />
    <input type="text" name="name" />
    <input type="email" name="email" />
    <input type="text" name="gathering" />
    <textarea name="message"></textarea>
    <input type="hidden" name="form_name" />
    <input type="hidden" name="formType" />
    <input type="hidden" name="subject" />
  </form>
</BaseLayout>

<script src="../scripts/gathering-animation.js"></script>
