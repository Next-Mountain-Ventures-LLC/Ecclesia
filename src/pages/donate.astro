---
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Donate | Ecclesia Tulsa";
const description = "Support Ecclesia through PayPal or Cash App.";
---

<BaseLayout {title} {description}>
  <div class="container py-20 md:py-32">
    <div class="max-w-2xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-display font-medium text-primary-800 mb-4">
          Support Ecclesia
        </h1>
        <p class="text-lg text-muted-foreground">
          Choose your preferred way to give
        </p>
      </div>

      <!-- Donation Options -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- PayPal Option -->
        <a 
          href="https://www.paypal.com/donate/?hosted_button_id=RM8SJ6QPAXN8Q"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col items-center justify-center p-12 bg-white rounded-2xl shadow-lg hover:shadow-2xl hover:scale-105 transition-all duration-300 border border-gray-200"
        >
          <svg class="h-24 w-24 mb-6 text-blue-600" viewBox="0 0 200 60" xmlns="http://www.w3.org/2000/svg">
            <g fill="currentColor">
              <path d="M46.211 13.27c-1.164 7.409-5.656 12.383-13.066 12.383H26.03l2.141-13.565h6.968c3.576 0 6.335-2.759 6.968-12.383h7.104z"/>
              <path d="M64.346 13.27c-1.164 7.409-5.656 12.383-13.066 12.383H47.165l2.141-13.565h6.968c3.576 0 6.335-2.759 6.968-12.383h7.104z"/>
              <path d="M82.481 13.27c-1.164 7.409-5.656 12.383-13.066 12.383H65.3l2.141-13.565h6.968c3.576 0 6.335-2.759 6.968-12.383h7.104z"/>
            </g>
          </svg>
          <h3 class="text-2xl font-display font-medium text-primary-800 mb-2">PayPal</h3>
          <p class="text-sm text-muted-foreground text-center">Donate via PayPal</p>
        </a>

        <!-- Cash App Option -->
        <a 
          href="#contact"
          class="group flex flex-col items-center justify-center p-12 bg-white rounded-2xl shadow-lg hover:shadow-2xl hover:scale-105 transition-all duration-300 border border-gray-200"
        >
          <svg class="h-24 w-24 mb-6 text-green-500" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <rect width="200" height="200" rx="45" fill="currentColor"/>
            <path d="M100 50C70.16 50 50 70.16 50 100c0 29.84 20.16 50 50 50s50-20.16 50-50c0-29.84-20.16-50-50-50zm0 80c-16.57 0-30-13.43-30-30s13.43-30 30-30 30 13.43 30 30-13.43 30-30 30z" fill="white"/>
            <path d="M100 85c-8.29 0-15 6.71-15 15s6.71 15 15 15 15-6.71 15-15-6.71-15-15-15z" fill="currentColor"/>
          </svg>
          <h3 class="text-2xl font-display font-medium text-primary-800 mb-2">Cash App</h3>
          <p class="text-sm text-muted-foreground text-center">Contact us for details</p>
        </a>
      </div>

      <!-- Back Link -->
      <div class="text-center mt-16">
        <a href="/" class="text-primary-600 hover:text-primary-800 font-medium transition-colors">
          ← Back to Home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
