---
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Donate | Ecclesia Tulsa";
const description = "Support Ecclesia through PayPal, Cash App, or Zelle.";
---

<BaseLayout {title} {description}>
  <div class="container py-20 md:py-32">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-display font-medium text-primary-800 mb-4">
          Support Ecclesia
        </h1>
        <p class="text-lg text-muted-foreground">
          Choose your preferred way to give
        </p>
      </div>

      <!-- Donation Options -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- PayPal Option -->
        <a
          href="https://www.paypal.com/donate/?hosted_button_id=RM8SJ6QPAXN8Q"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col items-center justify-center p-12 bg-white rounded-2xl shadow-lg hover:shadow-2xl hover:scale-105 transition-all duration-300 border border-gray-200"
        >
          <img
            src="https://cdn.builder.io/api/v1/image/assets%2F5193f7a05d654f0c98a0a70f48ef2387%2Fb848f8a42cba4a22bbe805ae34ce8508?format=webp&width=800&height=1200"
            alt="PayPal logo"
            class="h-24 w-auto mb-6"
          />
          <p class="text-sm text-muted-foreground text-center">Donate via PayPal</p>
        </a>

        <!-- Cash App Option -->
        <a
          href="https://cash.app/$TulsaEcclesiaNaz"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col items-center justify-center p-12 bg-white rounded-2xl shadow-lg hover:shadow-2xl hover:scale-105 transition-all duration-300 border border-gray-200"
        >
          <img
            src="https://cdn.builder.io/api/v1/image/assets%2F5193f7a05d654f0c98a0a70f48ef2387%2Fc96d70df4dd344dfbf620195d7b1601e?format=webp&width=800&height=1200"
            alt="Cash App logo"
            class="h-24 w-auto mb-6"
          />
          <p class="text-sm text-muted-foreground text-center">Donate Via Cash App</p>
        </a>
        <!-- Zelle Option -->
        <a
          href="https://enroll.zellepay.com/qr-codes?data=eyJuYW1lIjoiVFVMU0EgRUNDTEVTSUEgQ0hVUkNIIE9GIFRIRSBOQVpBUkVORSIsInRva2VuIjoicmFuZG9tYXh4QGdtYWlsLmNvbSJ9"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col items-center justify-center p-12 bg-white rounded-2xl shadow-lg hover:shadow-2xl hover:scale-105 transition-all duration-300 border border-gray-200"
        >
          <svg class="h-24 w-auto mb-6" viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg" aria-label="Zelle logo">
            <rect width="200" height="80" rx="12" fill="#6D1ED4"/>
            <text x="100" y="54" font-family="Arial, sans-serif" font-size="46" font-weight="bold" fill="white" text-anchor="middle" letter-spacing="-1">zelle</text>
          </svg>
          <p class="text-sm text-muted-foreground text-center">Donate via Zelle</p>
        </a>
      </div>

      <!-- Back Link -->
      <div class="text-center mt-16">
        <a href="/" class="text-primary-600 hover:text-primary-800 font-medium transition-colors">
          ← Back to Home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
