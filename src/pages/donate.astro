              </g>
            </svg>
          </div>
          <p class="text-sm text-muted-foreground text-center">Donate via Zelle</p>
        </a>
      </div>

      <!-- Back Link -->
      <div class="text-center mt-16">
        <a href="/" class="text-primary-600 hover:text-primary-800 font-medium transition-colors">
          ← Back to Home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
