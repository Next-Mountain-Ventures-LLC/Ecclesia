          </div>
        </div>

        <div>
          <div class="bg-primary-50 p-6 rounded-lg mb-6">
            <h3 class="text-xl font-display text-primary-800 mb-4">Seven Key Characteristics</h3>
            <p class="mb-4 text-sm">These values are expressed through these seven key characteristics:</p>
            
            <div class="space-y-2">
              <div class="flex items-center">
                <div class="w-8 h-8 rounded-full bg-primary-100 flex items-center justify-center mr-3 text-primary-700">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
