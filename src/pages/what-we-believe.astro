---

<BaseLayout {title} {description}>
  <div class="container py-12 md:py-20">
    <div class="mx-auto max-w-4xl text-center">
      <div class="flex flex-col items-center justify-center mb-6">
        <img 
          src="/assets/nazarene-logo-5_gray_en_nw_29ef5773.png" 
          alt="Church of the Nazarene logo"
          width="200" 
          height="59"
          class="h-auto max-w-[200px] mb-6"
        />
      </div>
      <h1 class="font-display text-3xl font-medium tracking-tight text-primary-800 md:text-5xl">
        What We Believe
      </h1>
      <p class="mt-4 text-lg text-muted-foreground md:text-xl">
        As an affiliate of the Church of the Nazarene, our beliefs are rooted in Scripture and grounded in Christian tradition.
      </p>
    </div>
    
    <div class="mx-auto max-w-5xl mt-12">
      <!-- Tabs implementation -->
      <div class="w-full">
        <div class="grid w-full grid-cols-3 bg-muted rounded-lg p-1">
          {tabs.map((tab) => (
            <button 
              id={`tab-${tab.id}`}
              class={`tab-trigger px-3 py-2 text-sm font-medium rounded-md transition-colors ${tab.id === "mission" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground"}`}
              data-tab={tab.id}
            >
              {tab.label}
            </button>
          ))}
        </div>
        
        <div class="mt-6">
          {tabs.map((tab) => (
            <div
              id={`tab-content-${tab.id}`}
              class={`tab-content bg-white p-6 md:p-8 shadow-sm rounded-lg ${tab.id === "mission" ? "block" : "hidden"} ${tab.id === "articles-of-faith" ? "" : "prose prose-slate max-w-none"}`}
            >
              {tab.id === "articles-of-faith" ? (
                <ArticlesOfFaith client:load />
              ) : (
                <div set:html={tab.content} />
              )}
            </div>
          ))}
        </div>
      </div>
      
      <div class="mt-12 text-center">
        <a href="/" class={buttonVariants({ variant: "outline" })}>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4">
            <path d="m12 19-7-7 7-7" />
            <path d="M19 12H5" />
          </svg>
          Back to Home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<!-- Create PDF files for downloads -->
<script>
  // Helper function to save a PDF
  function savePDF(filename, content) {
    const blob = new Blob([content], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.style.display = 'none';
    a.click();
    
    setTimeout(() => {
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }, 100);
  }

  // Tab functionality
  document.addEventListener('DOMContentLoaded', () => {
    setupTabs();
  });
  
  document.addEventListener('astro:page-load', () => {
    setupTabs();
  });
  
  function setupTabs() {
    const tabTriggers = document.querySelectorAll('.tab-trigger');
    const tabContents = document.querySelectorAll('.tab-content');

    tabTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        // Remove active class from all triggers
        tabTriggers.forEach(t => {
          t.classList.remove('bg-background', 'text-foreground', 'shadow-sm');
          t.classList.add('text-muted-foreground', 'hover:text-foreground');
        });
        
        // Add active class to clicked trigger
        trigger.classList.add('bg-background', 'text-foreground', 'shadow-sm');
        trigger.classList.remove('text-muted-foreground', 'hover:text-foreground');
        
        // Hide all tab contents
        tabContents.forEach(content => {
          content.classList.add('hidden');
        });
        
        // Show the selected tab content
        const tabId = trigger.getAttribute('data-tab');
        const content = document.getElementById(`tab-content-${tabId}`);
        if (content) {
          content.classList.remove('hidden');
        }
      });
    });
  }
</script>
