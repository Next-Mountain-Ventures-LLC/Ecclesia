<!-- Create PDF files for downloads -->
<script>
  // Helper function to save a PDF
  function savePDF(filename, content) {
    const blob = new Blob([content], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.style.display = 'none';
    a.click();
    
    setTimeout(() => {
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }, 100);
  }

  // Tab functionality
  document.addEventListener('DOMContentLoaded', () => {
    setupTabs();
  });
  
  document.addEventListener('astro:page-load', () => {
    setupTabs();
  });
  
  function setupTabs() {
    const tabTriggers = document.querySelectorAll('.tab-trigger');
    const tabContents = document.querySelectorAll('.tab-content');

    tabTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        // Remove active class from all triggers
        tabTriggers.forEach(t => {
          t.classList.remove('bg-background', 'text-foreground', 'shadow-sm');
          t.classList.add('text-muted-foreground', 'hover:text-foreground');
        });
        
        // Add active class to clicked trigger
        trigger.classList.add('bg-background', 'text-foreground', 'shadow-sm');
        trigger.classList.remove('text-muted-foreground', 'hover:text-foreground');
        
        // Hide all tab contents
        tabContents.forEach(content => {
          content.classList.add('hidden');
        });
        
        // Show the selected tab content
        const tabId = trigger.getAttribute('data-tab');
        const content = document.getElementById(`tab-content-${tabId}`);
        if (content) {
          content.classList.remove('hidden');
        }
      });
    });
  }
</script>

<script define:vars={{ pdfData }}>
  // Create directories
  const createDirectories = async () => {
    try {
      const response = await fetch('/assets/mission-statement.pdf', { method: 'HEAD' });
      if (response.status === 404) {
        // Ensure the public directory exists
        fetch('/assets/mission-statement.pdf', {
          method: 'PUT',
          body: pdfData
        });
        
        fetch('/assets/core-values.pdf', {
          method: 'PUT',
          body: pdfData
        });
        
        fetch('/assets/articles-of-faith.pdf', {
          method: 'PUT',
          body: pdfData
        });
      }
    } catch (error) {
      console.error('Error creating PDF files:', error);
    }
  };

  createDirectories();
</script>