                    <circle cx="12" cy="12" r="2" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-display text-primary-800 mb-2">Missional</h3>
                  <p class="text-sm">
                    We are a sent people—into homes, workplaces, communities, and villages as well as other cities and countries. Our mission is to be actively participating in God's mission of reconciling the world to Himself.
                  </p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="flex justify-center mt-6">
            <div class="text-center">
              <p class="text-sm text-primary-700 font-medium mb-2">Download our detailed Core Values document</p>
              <a href="/assets/core-values.pdf" download="Ecclesia-Core-Values.pdf" class="inline-flex items-center px-4 py-2 bg-primary-100 border border-primary-200 text-primary-800 rounded-md hover:bg-primary-200 transition-colors shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4 text-primary-700">
                  <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                  <polyline points="14 2 14 8 20 8" />
                  <path d="M12 18v-6" />
                  <path d="m9 15 3 3 3-3" />
                </svg>
                <span class="font-medium">Download Core Values PDF</span>
              </a>
